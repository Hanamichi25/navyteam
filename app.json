{
  "expo": {
    "name": "navyteam",
    "slug": "navyteam",
    "version": "1.0.0",
    "scheme": "navyteam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navyteam.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.navyteam.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#1D74B8"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53c63dd9-9328-4523-a2a8-7d7e2ff76e57"
      }
    },
    "owner": "drmartinn25"
  }
}
